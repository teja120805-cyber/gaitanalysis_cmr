# Copy to .env and adjust. All values have sensible zero-infra defaults.

# --- Database ---------------------------------------------------------------
# Default: local SQLite (no setup). For production, point at Postgres/Timescale:
#   DATABASE_URL=postgresql+asyncpg://gaitguard:pass@localhost:5432/gaitguard
DATABASE_URL=sqlite+aiosqlite:///./gaitguard.db

# --- Realtime ---------------------------------------------------------------
# Leave blank to use the in-process pub/sub (single worker). For multi-worker,
# set a Redis URL:  redis://localhost:6379/0
REDIS_URL=

# --- Auth -------------------------------------------------------------------
JWT_SECRET=change-me-in-production-please-use-a-long-random-value
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Device ingest token (ESP32 / vision worker auth). Demo shared secret.
INGEST_TOKEN=gaitguard-device-token

# --- CORS -------------------------------------------------------------------
# Comma-separated origins allowed to call the API / open the dashboard WS.
CORS_ORIGINS=http://localhost:3000

# Seed demo users + patients on startup (1/0).
SEED_ON_STARTUP=1
